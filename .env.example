# Public site URL (used for SEO metadata, sitemap and email links)
NEXT_PUBLIC_SITE_URL=https://cardboardmania.com

# Where contact-form emails are delivered
CONTACT_TO_EMAIL=cardboardmania33@gmail.com

# Resend (https://resend.com) — transactional email. Without a key, emails are logged to the console.
RESEND_API_KEY=
# Must be on a domain verified in Resend
CONTACT_FROM_EMAIL="Cardboard Mania <no-reply@cardboardmania.com>"

# Supabase — stores submissions (backup) and uploaded photos. Without these, photo upload is hidden.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=contact-photos

# Cloudflare Turnstile — optional invisible spam challenge
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
